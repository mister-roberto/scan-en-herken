# Kopieer dit bestand naar ".env" en vul de API-sleutel van Anthropic in.
# De sleutel maakt u aan op https://console.anthropic.com (API keys).
ANTHROPIC_API_KEY=

# Optioneel: de eerste beheerder vooraf aanmaken (e-mailadres:wachtwoord, minstens 10 tekens).
# Alleen nodig als het programma direct voor het netwerk wordt opengezet; anders maakt u de beheerder aan in de browser.
# SCAN_BEHEERDER=
