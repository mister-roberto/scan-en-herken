{
  "name": "scan-en-herken",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scan & Herken - facturen en bonnen met AI uitlezen, omzetten in journaalposten en exporteren naar Exact Online",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "demo": "SCAN_DEMO=1 node --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
